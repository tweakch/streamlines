<?xml version="1.0" encoding="utf-8"?>
<!--
  Nur nuget.org — bewusst lokal.

  C:\dev\nuget.config haengt den privaten wwimmo-Feed ein. Der gilt fuer alles
  unterhalb von C:\dev, verlangt aber Authentifizierung; die Aspire-CLI laeuft
  darum bei jeder Paket-Operation in einen Timeout und haengt ohne Meldung.
  <clear/> schneidet die geerbten Quellen ab, ohne die globale Datei anzufassen.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
